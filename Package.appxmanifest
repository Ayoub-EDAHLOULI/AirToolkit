<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 rescap">

  <!-- Name and Publisher must match Partner Center exactly:
       Product > Product management > Product identity.
       Version is overwritten by CI from src-tauri/tauri.conf.json. -->
  <Identity
    Name="AyoubEdahlouli.AirToolkit"
    Publisher="CN=3F23C282-C55B-4E6D-B00E-682426399DDE"
    Version="0.1.1.0" />

  <Properties>
    <DisplayName>AirToolkit</DisplayName>
    <PublisherDisplayName>Ayoub Edahlouli</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:PackageIntegrity>
      <uap10:Content Enforcement="on"/>
    </uap10:PackageIntegrity>
  </Properties>

  <Dependencies>
    <!-- Windows 10 1809+ is fine: AirToolkit only keeps theme/scratchpad in the
         WebView's localStorage (virtualized AppData is OK) and writes files only
         where the user picks in a save dialog. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26200.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us"/>
  </Resources>

  <Applications>
    <Application Id="AirToolkit"
      Executable="airtoolkit.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="AirToolkit"
        Description="Offline developer toolbox: everyday dev and IT utilities in one native app, with zero network calls."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\MedTile.png"
        Square44x44Logo="Assets\AppList.png" />
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
